# Copy to .env.playwright and fill values. Loaded automatically by `pnpm test:e2e`.
# Base URL of the frontend dev server
PLAYWRIGHT_BASE_URL=http://localhost:3001

# Shared fallback account (used when role-specific vars are not set)
PLAYWRIGHT_USER_EMAIL=
PLAYWRIGHT_USER_PASSWORD=

# Player (VDV) account - must NOT have organizer role (used by 02-user-registration.spec.ts)
PLAYWRIGHT_PLAYER_EMAIL=
PLAYWRIGHT_PLAYER_PASSWORD=

# Organizer (BTC) account (used by 03-admin-operations.spec.ts)
PLAYWRIGHT_ORGANIZER_EMAIL=
PLAYWRIGHT_ORGANIZER_PASSWORD=

# Existing tournament id, e.g. from /organizer/tournaments/<ID>/manage
# (used by 02-user-registration.spec.ts, 03-admin-operations.spec.ts, 04-user-tracking.spec.ts)
PLAYWRIGHT_TOURNAMENT_ID=
